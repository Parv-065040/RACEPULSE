      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "racepulse-mysql"
          },
          "rawSql": "SELECT event_time AS time,\n       car_id AS car,\n       CASE kpi_id\n         WHEN 'RC-001' THEN 'TRACK RISK'\n         WHEN 'RC-002' THEN 'VEHICLE RISK'\n         ELSE kpi_id\n       END AS signal,\n       ROUND(value,2) AS value,\n       severity AS status,\n       message\nFROM race_control_results\nWHERE severity <> 'none'\n  AND $__timeFilter(event_time)\nORDER BY event_time DESC\nLIMIT 20",
          "format": "table"
        }
      ],
      "id": 11
