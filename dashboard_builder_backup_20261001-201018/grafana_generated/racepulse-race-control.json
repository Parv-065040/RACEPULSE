      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "racepulse-mysql"
          },
          "rawSql": "SELECT\n    car_id AS car,\n    MAX(CASE WHEN kpi_id='RC-001' THEN ROUND(value,2) END) AS track_risk,\n    MAX(CASE WHEN kpi_id='RC-002' THEN ROUND(value,2) END) AS vehicle_risk,\n    MAX(CASE WHEN kpi_id='RC-001' THEN severity END) AS track_status,\n    MAX(CASE WHEN kpi_id='RC-002' THEN severity END) AS vehicle_status,\n    MAX(lap_number) AS lap\nFROM race_control_results\nWHERE $__timeFilter(event_time)\n  AND car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\nGROUP BY car_id\nORDER BY car_id",
          "format": "table"
        }
      ],
      "id": 10
