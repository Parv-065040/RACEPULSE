            "type": "mysql",
            "uid": "racepulse-mysql"
          },
          "rawSql": "SELECT COALESCE(\n    (\n        SELECT k.lap_number\n        FROM kpi_results k\n        WHERE k.event_time = (\n            SELECT MAX(k2.event_time)\n            FROM kpi_results k2\n            WHERE k2.car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\n        )\n        AND k.lap_number BETWEEN 1 AND 60\n        LIMIT 1\n    ),\n    0\n) AS value",
          "format": "table"
        }
