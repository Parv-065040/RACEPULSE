    {
      "id": 5,
      "type": "table",
      "title": "Live Pace & Gap",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "racepulse-mysql"
      },
      "targets": [
        {
          "rawSql": "SELECT kr.car_id,kr.lap_number,kr.delta_ms pace_delta_ms,\ngt.gap_to_leader_ms,gt.trend_ms_per_lap\nFROM kpi_results kr\nLEFT JOIN gap_trend_results gt ON gt.car_id=kr.car_id AND gt.lap_number=kr.lap_number\nJOIN (SELECT car_id,MAX(id) id FROM kpi_results GROUP BY car_id) latest ON latest.id=kr.id\nORDER BY kr.car_id",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Race Control Alerts",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "mysql",
        "uid": "racepulse-mysql"
      },
      "targets": [
        {
          "rawSql": "SELECT created_at time,car_id,kpi_id,severity,message,value\nFROM race_control_results WHERE severity<>'none'\nORDER BY created_at DESC LIMIT 20",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true
      }
    },
