          "datasource": {
            "type": "mysql",
            "uid": "racepulse-mysql"
          },
          "rawSql": "WITH race AS (\n    SELECT\n        MAX(event_time) AS race_end,\n        DATE_SUB(MAX(event_time), INTERVAL 10 MINUTE) AS race_start\n    FROM kpi_results\n    WHERE car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\n      AND lap_number BETWEEN 1 AND 60\n)\n, ranked AS (\n    SELECT kr.*,\n           ROW_NUMBER() OVER (PARTITION BY kr.car_id ORDER BY kr.event_time DESC, kr.id DESC) AS rn\n    FROM kpi_results kr CROSS JOIN race\n    WHERE kr.event_time BETWEEN race.race_start AND race.race_end\n      AND kr.lap_number BETWEEN 1 AND 60\n      AND kr.car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\n), gap_ranked AS (\n    SELECT gt.*,\n           ROW_NUMBER() OVER (PARTITION BY gt.car_id, gt.lap_number ORDER BY gt.event_time DESC, gt.id DESC) AS rn\n    FROM gap_trend_results gt CROSS JOIN race\n    WHERE gt.event_time BETWEEN race.race_start AND race.race_end\n      AND gt.lap_number BETWEEN 1 AND 60\n      AND gt.car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\n)\nSELECT r.car_id AS car,\n       r.lap_number AS lap,\n       ROUND(r.lap_time_ms/1000.0,3) AS lap_time_s,\n       ROUND(r.best_lap_time_ms/1000.0,3) AS best_lap_s,\n       ROUND(r.delta_ms/1000.0,3) AS pace_delta_s,\n       r.severity AS pace_status,\n       ROUND(COALESCE(g.gap_to_leader_ms,0)/1000.0,3) AS gap_s,\n       ROUND(COALESCE(g.trend_ms_per_lap,0)/1000.0,3) AS gap_trend_s_per_lap,\n       COALESCE(g.severity,'none') AS gap_status\nFROM ranked r\nLEFT JOIN gap_ranked g ON g.car_id=r.car_id AND g.lap_number=r.lap_number AND g.rn=1\nWHERE r.rn=1\nORDER BY r.car_id",
          "format": "table"
        }
      ],
