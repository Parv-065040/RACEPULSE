      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "racepulse-mysql"
          },
          "rawSql": "WITH race AS (\n    SELECT\n        MAX(event_time) AS race_end,\n        DATE_SUB(MAX(event_time), INTERVAL 10 MINUTE) AS race_start\n    FROM kpi_results\n    WHERE car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\n      AND lap_number BETWEEN 1 AND 60\n)\n\nSELECT COUNT(*) AS value FROM alerts a CROSS JOIN race\nWHERE a.kpi_id='SYS-STALE'\n  AND a.created_at BETWEEN DATE_SUB(race.race_end, INTERVAL 10 MINUTE) AND DATE_ADD(race.race_end, INTERVAL 10 MINUTE)",
          "format": "table"
        }
      ],
