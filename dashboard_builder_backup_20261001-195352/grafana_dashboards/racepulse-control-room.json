    {
      "type": "barchart",
      "title": "Lap Pace Delta by Car",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "P8C42F0B79DF81FAF"
      },
      "targets": [
        {
          "rawSql": "SELECT\n    CONCAT('Lap ', lap_number) AS lap,\n    MAX(CASE WHEN car_id = 'CAR_01' THEN delta_ms END) AS CAR_01,\n    MAX(CASE WHEN car_id = 'CAR_02' THEN delta_ms END) AS CAR_02,\n    MAX(CASE WHEN car_id = 'CAR_03' THEN delta_ms END) AS CAR_03\nFROM kpi_results\nGROUP BY lap_number\nORDER BY lap_number;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "type": "barchart",
      "title": "Gap Trend by Car / Lap",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "datasource": {
        "type": "mysql",
        "uid": "P8C42F0B79DF81FAF"
      },
      "targets": [
        {
          "rawSql": "SELECT\n    CONCAT('Lap ', lap_number) AS lap,\n    MAX(CASE WHEN car_id = 'CAR_01' THEN trend_ms_per_lap END) AS CAR_01,\n    MAX(CASE WHEN car_id = 'CAR_02' THEN trend_ms_per_lap END) AS CAR_02,\n    MAX(CASE WHEN car_id = 'CAR_03' THEN trend_ms_per_lap END) AS CAR_03\nFROM gap_trend_results\nGROUP BY lap_number\nORDER BY lap_number;",
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "orientation": "vertical",
        "xTickLabelRotation": 0,
