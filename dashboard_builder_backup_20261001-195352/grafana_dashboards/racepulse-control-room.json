    {
      "type": "table",
      "title": "Recent Alerts",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 12
      },
      "datasource": {
        "type": "mysql",
        "uid": "P8C42F0B79DF81FAF"
      },
      "targets": [
        {
          "rawSql": "SELECT\n    created_at AS time,\n    car_id AS car,\n    kpi_id AS alert_signal,\n    severity,\n    message,\n    delta_ms\nFROM alerts\nWHERE created_at >= NOW() - INTERVAL 24 HOUR\nORDER BY created_at DESC\nLIMIT 20;",
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "type": "table",
      "title": "Current Car Status",
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "datasource": {
        "type": "mysql",
        "uid": "P8C42F0B79DF81FAF"
      },
      "targets": [
        {
          "format": "table",
          "rawSql": "SELECT\n    kr.car_id AS car,\n    kr.lap_number AS latest_lap,\n    kr.lap_time_ms,\n    kr.best_lap_time_ms AS best_lap_ms,\n    kr.delta_ms AS pace_delta_ms,\n    kr.severity AS pace_status,\n    gt.gap_to_leader_ms AS gap_to_leader_ms,\n    gt.trend_ms_per_lap AS gap_trend_ms_per_lap,\n    gt.severity AS gap_status\nFROM kpi_results kr\nINNER JOIN (\n    SELECT\n        car_id,\n        MAX(id) AS latest_id\n    FROM kpi_results\n    GROUP BY car_id\n) latest\n    ON kr.car_id = latest.car_id\n    AND kr.id = latest.latest_id\nLEFT JOIN gap_trend_results gt\n    ON gt.car_id = kr.car_id\n    AND gt.lap_number = kr.lap_number\nORDER BY kr.car_id;"
        }
      ],
      "options": {
        "showHeader": true
      }
    }
  ],
