      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        },
        "sortBy": []
      },
      "targets": [
        {
          "datasource": {
            "type": "mysql",
            "uid": "racepulse-mysql"
          },
          "rawSql": "SELECT\n    kr.car_id AS car,\n    kr.lap_number AS latest_lap,\n    kr.lap_time_ms,\n    kr.best_lap_time_ms AS best_lap_ms,\n    kr.delta_ms AS pace_delta_ms,\n    kr.severity AS pace_status,\n    gt.gap_to_leader_ms,\n    gt.trend_ms_per_lap AS gap_trend_ms_per_lap,\n    gt.severity AS gap_status\nFROM kpi_results kr\nINNER JOIN (\n    SELECT\n        car_id,\n        MAX(id) AS latest_id\n    FROM kpi_results\n    WHERE $__timeFilter(event_time)\n      AND car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\n    GROUP BY car_id\n) latest\n    ON latest.car_id = kr.car_id\n   AND latest.latest_id = kr.id\nLEFT JOIN (\n    SELECT\n        g.car_id,\n        g.gap_to_leader_ms,\n        g.trend_ms_per_lap,\n        g.severity,\n        g.lap_number\n    FROM gap_trend_results g\n    INNER JOIN (\n        SELECT\n            car_id,\n            MAX(id) AS latest_id\n        FROM gap_trend_results\n        WHERE $__timeFilter(event_time)\n          AND car_id REGEXP '^CAR_(0[1-9]|1[0-2])$'\n        GROUP BY car_id\n    ) latest_gap\n        ON latest_gap.car_id = g.car_id\n       AND latest_gap.latest_id = g.id\n) gt\n    ON gt.car_id = kr.car_id\nORDER BY kr.car_id",
          "format": "table",
          "refId": "A"
        }
      ]
    },
